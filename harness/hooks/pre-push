#!/bin/sh
# Instruction #110 Part C: refuse a push that carries a commit whose `Proposer:` or `Instruction:` trailers git does not
# parse (`python -m harness.claims trailers`). Installed by `git config core.hooksPath harness/hooks` in build.yml and
# review.yml. It reads the branch's unpushed commits: from its upstream, or from origin/master for a branch not yet
# pushed. A refused push is answered by amending the session's own unpushed commit, never by an exemption entry.
# Instruction #211 item 3: it also refuses a push whose commits add or change a STATUS file P0l would reject
# (`python -m harness.claims status-check`).
here=$(cd "$(dirname "$0")/../.." && pwd) || exit 1
base=$(git rev-parse -q --verify '@{u}' 2>/dev/null || git rev-parse -q --verify origin/master) || {
  echo "pre-push: refused: neither an upstream nor origin/master to read the unpushed commits from" >&2
  exit 1
}
PYTHONPATH="$here" python3 -B -m harness.claims trailers "$base..HEAD" --repo . || {
  echo "pre-push: refused: amend your own unpushed commit so that git parses its trailers (instruction #110)" >&2
  exit 1
}
# Review ef1e03c F7: it refuses a push carrying a commit whose author is not the account its proposer acts through
# (`python -m harness.claims authors`), while that commit can still be amended.
PYTHONPATH="$here" python3 -B -m harness.claims authors "$base" HEAD --repo . || {
  echo "pre-push: refused: re-author your own unpushed commit as the account you act through, e.g. git commit --amend --no-edit --author='assize-reviewer <assize-reviewer@users.noreply.github.com>' (review ef1e03c F7)" >&2
  exit 1
}
statuses=$(git diff --name-only --diff-filter=AM "$base...HEAD" -- 'reports/L*/status/*.md') || {
  echo "pre-push: refused: cannot read the STATUS files the unpushed commits add or change" >&2
  exit 1
}
[ -z "$statuses" ] || PYTHONPATH="$here" python3 -B -m harness.claims status-check $statuses --repo . || {
  echo "pre-push: refused: take the header sha and the citation from python -m harness.ledger cite --head <sha>" >&2
  exit 1
}
