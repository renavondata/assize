{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assize.local/worlds/spec/manifest.schema.json",
  "schema_version": "1.0.0",
  "title": "World manifest",
  "description": "Declares, as data, every name a World uses: observation fields, the action set and prediction targets. No such name appears in an interface schema (brief 1 section 1; P6).",
  "type": "object",
  "required": ["schema_version", "world", "source", "observation", "actions", "targets", "utility", "price"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "world": {"$ref": "#/$defs/identifier"},
    "source": {
      "description": "The upstream package the binding wraps, pinned by version.",
      "type": "object",
      "required": ["package", "version"],
      "additionalProperties": false,
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "episode_length": {
      "description": "Steps after which the World truncates an episode, if it does.",
      "type": "integer",
      "minimum": 1
    },
    "observation": {
      "description": "Observation fields. A categorical field travels as integer indices into its vocabulary; an integer field travels as integers within its range.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/field"}
    },
    "actions": {
      "description": "The action set. An action travels as its integer index in this list.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "targets": {
      "description": "Prediction targets: each a categorical variable with finite declared support, realised once the World advances.",
      "type": "array",
      "items": {"$ref": "#/$defs/target"}
    },
    "utility": {
      "description": "The per-episode scalar the judge scores, and the vocabulary of the components it records beside it.",
      "type": "object",
      "required": ["description", "components"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "price": {
      "description": "The exchange rate of compute into the per-episode utility: utility per CPU-second and per gigabyte-second (1e9 bytes) of peak memory, committed with its derivation. `delta` is the smallest difference in per-episode utility the World's FIT criterion requires the court to detect; the rates are its derivation, an episode exhausting every allowance charged `delta`, half for each resource (judge/price.py).",
      "type": "object",
      "required": ["cpu_s", "memory_gb_s", "delta", "rationale"],
      "additionalProperties": false,
      "properties": {
        "delta": {"type": "number", "exclusiveMinimum": 0},
        "cpu_s": {"type": "number", "exclusiveMinimum": 0},
        "memory_gb_s": {"type": "number", "exclusiveMinimum": 0},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "rationale": {"type": "string"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "shape": {
      "description": "Array dimensions; the empty list is a scalar.",
      "type": "array",
      "items": {"type": "integer", "minimum": 1}
    },
    "field": {
      "type": "object",
      "required": ["name", "type", "shape"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["categorical", "integer"]},
        "shape": {"$ref": "#/$defs/shape"},
        "vocabulary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "range": {
          "description": "Inclusive bounds.",
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "oneOf": [
        {"properties": {"type": {"const": "categorical"}}, "required": ["vocabulary"], "not": {"required": ["range"]}},
        {"properties": {"type": {"const": "integer"}}, "required": ["range"], "not": {"required": ["vocabulary"]}}
      ],
      "unevaluatedProperties": false
    },
    "target": {
      "type": "object",
      "required": ["name", "field", "horizon", "support", "rationale"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "field": {"$ref": "#/$defs/identifier"},
        "horizon": {
          "description": "Steps ahead of the observation the candidate replies to.",
          "const": 1
        },
        "support": {
          "description": "Finite support, in order. A prediction is a list of probabilities aligned with it.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": ["integer", "string"]}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
